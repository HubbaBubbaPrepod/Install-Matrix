# This file documents supported settings. The installer writes the real
# /root/matrix-server/.env with mode 0600 and generated secrets.
SERVER_NAME=example.com
DOMAIN=matrix.example.com
ADMIN_EMAIL=admin@example.com
EXTERNAL_IP=203.0.113.10

REGISTRATION_MODE=closed
FEDERATION_MODE=public
MAX_UPLOAD_SIZE=2048M
REMOTE_MEDIA_LIFETIME=14d
PRESENCE_ENABLED=false

MAS_DOMAIN=mas.example.com
LIVEKIT_DOMAIN=livekit.example.com
KETESA_DOMAIN=admin.example.com
ELEMENT_ADMIN_DOMAIN=element-admin.example.com
NTFY_DOMAIN=ntfy.example.com

PROXY_ENABLED=false
CONTAINER_PROXY_URL=

POSTGRES_IMAGE=postgres:16.15-alpine
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.158.0
COTURN_IMAGE=coturn/coturn:4.17.2-r0
MAS_IMAGE=ghcr.io/element-hq/matrix-authentication-service:1.22.0
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.5
LK_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:0.5.0
KETESA_IMAGE=ghcr.io/etkecc/ketesa:v1.4.0
ELEMENT_ADMIN_IMAGE=oci.element.io/element-admin:0.1.12
NTFY_IMAGE=binwiederhier/ntfy:v2.27.0
XRAY_VERSION=v26.3.27
